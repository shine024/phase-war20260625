# ═══════════════════════════════════════
# Godot 4 — phase-war .gitignore
# ═══════════════════════════════════════

# ── Godot 引擎生成 ──
.godot/

# ── 构建产物 ──
build/
bin/
*.exe
*.dll
*.so
*.dylib
*.app

# ── 临时下载/转换目录（音频/图片等资源的下载源和中间产物，不入库）──
tmp_audio_dl/
tmp_*/

# ── 导出预设（已入库 33afd7b；勿向此文件写入密钥类字段：加密留空、encrypt_pck=false）──
#export_presets.cfg
!export_presets.cfg

# ── IDE / 编辑器 ──
.vs/
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── OS 生成文件 ──
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# ── Windows 保留设备名误生成（Git Bash 下 `> nul` 会创建文件而非丢弃）──
nul
nul_

# ── 命令误重定向产生的垃圾文件（数字/特殊字符文件名）──
# 注：原 `0{c++` 未闭合 glob 会让 ripgrep 解析 .gitignore 直接报错退出，
# 改成字符类 [ {] 按字面匹配同样的文件名。
0)
0[{]c++
531
_s3_test.txt
C:Users*


# ── 临时分析/探针脚本工作目录（.zcode，CLI 探针残留，勿入库）──
.zcode/

# ── Claude Code 本地配置 ──
.claude/settings.local.json
.claude/agent-memory/
CLAUDE.local.md

# ── 内部规划文档（不公开）──
expansions/
production/session-logs/

# ── 自动生成的文档 ──
docs/consistency-failures.md

# ── 临时文件和缓存 ──
*.tmp
*.temp
*.cache
*.log
*.stackdump
PixPin_*.mp4
__pycache__/
*.pyc
node_modules/
.deepvcode/

# ── 测试/临时脚本（不应进入版本库）──
# 批次8（2026-08-23）：删除过宽的 test_*.gd 规则——它把 7 个正式 gdunit 套件
# （balance 三件/economy 数据/相位仪/master 战力×2/UI 编译）挡在版本库外，
# CI 门禁从未跑过它们。正式套件命名就是 tests/unit/**/test_*.gd；
# 临时脚本走显式文件名（不进库的直接不 add，_tmp_* 批次审计脚本反而要进库）。
tmp_*
gen_*.py
# 白名单：术语映射生成器（批次① Task 3）为常驻工具非临时脚本。已跟踪文件
# gitignore 本无实效，此行是给协作者的意图声明（防被当作可删的生成物）
!tools/gen_term_mapping_draft.py
update_unit_manifest.py
*_backup*
# 白名单：美术备份打包铁律脚本（v30.6）是常驻工具非备份产物，勿被上一行误伤
!tools/pack_art_backup.py
*_v3_fixed*
data/test_half1*

# ── 压缩包 ──
*.zip
*.tar.gz
*.rar
*.7z

# ── 二进制资源文件（图片、音频、视频，不通过 Git 管理）──
# 图片
*.png
*.jpg
*.jpeg
*.svg
*.bmp
*.webp
*.tga
*.exr
*.hdr
*.gif
*.ico
!icon.ico
*.dds
# 音频
*.mp3
*.wav
*.ogg
*.flac
# Godot 导入缓存（会自动重新生成）
*.import

# ── 密钥和环境变量 ──
.env
.env.local
.env.*.local
*.pem
*.key
credentials.json
secrets.json

# API 密钥（本地保留，不入库）
tools/_api_key.txt
tools/_api_keys_level1.txt
tools/level_bg_workflow/api_keys.txt

# ── GdUnit 测试报告产物（一次性输出，不入库）──
reports/
tests/*.gd.uid
.font_src/

# Steam 预告片等大体积视频不入库（美术二进制纪律同 png）
*.mp4
