## 驻守关战前台词（带 master 名前缀的横幅串）；非驻守关/未注入 → 空数组
static func get_pre_battle_lines(level: int) -> Array[String]:
	var master_id := PhaseMasterGarrison.get_garrison_master_id(level)
	if master_id.is_empty() or not GARRISON_LINES.has(master_id):
		return []
	var entry: Dictionary = GARRISON_LINES[master_id]
	var master_name := _master_display_name(master_id)
	var out: Array[String] = []
	for line in entry.get("pre", []):
		var text := String(line)
		if text.is_empty():
			continue
		out.append((master_name + "　" + text) if not master_name.is_empty() else text)
	return out

## 驻守关战后遗言（结算面板战报页）；非驻守关/未注入/战败 → 空串
static func get_post_battle_line(level: int) -> String:
	var master_id := PhaseMasterGarrison.get_garrison_master_id(level)
	if master_id.is_empty() or not GARRISON_LINES.has(master_id):
		return ""
	return String(GARRISON_LINES[master_id].get("post", ""))

## 驻守关战后遗言的署名（master 显示名）；遗言为空时无意义
static func get_post_battle_master_name(level: int) -> String:
	return _master_display_name(PhaseMasterGarrison.get_garrison_master_id(level))

## 时代首关仪式串（[独白句…, 大横幅]）；非首关/未注入/本会话已播 → 空数组。
## 去重为运行态（static var）：一次游戏会话每个仪式只播一次，重开游戏重播
#（里程碑仪式的"回到游戏"重复可接受，且零存档侵入）。
static var _era_rite_shown: Dictionary = {}

static func get_era_rite_lines(level: int) -> Array[String]:
	if not ERA_RITES.has(level) or _era_rite_shown.has(level):
		return []
	_era_rite_shown[level] = true
	var entry: Dictionary = ERA_RITES[level]
	var out: Array[String] = []
	for line in entry.get("monologue", []):
		if not String(line).is_empty():
			out.append(String(line))
	var banner := String(entry.get("banner", ""))
	if not banner.is_empty():
		out.append(banner)
	return out

## 关卡说明牌副句（陈末视角）；未注入 → 空串
static func get_level_echo(level: int) -> String:
	return String(LEVEL_ECHO.get(level, ""))

## L100 结局演出数据（monologue/credits/hook）；直接读 ENDING，常量保证存在
static func get_ending() -> Dictionary:
	return ENDING

static func _master_display_name(master_id: String) -> String:
	if master_id.is_empty():
		return ""
	var master := EnemyPhaseMasters.get_master_by_id(master_id)
	return String(master.get("name", ""))
