static func get_foot_frac(file_name: String) -> float:
	return float(FOOT_FRAC.get(file_name, 0.0))

static func get_head_frac(file_name: String) -> float:
	return float(HEAD_FRAC.get(file_name, 0.0))

## 从纹理路径提文件名（去目录去扩展名）。
static func _file_name_of(tex: Texture2D) -> String:
	if tex == null or tex.resource_path == null or tex.resource_path.is_empty():
		return ""
	return String(tex.resource_path).get_file().get_basename()

## 返回实体顶部相对节点原点(地面线 y=0)的 Y 坐标（负值，在脚上方）。
## 供血条/头顶 UI 锚定实体顶部，保证距离不随缩放/卡框浮动。
static func entity_top_y_for_sprite(unit_spr: Sprite2D) -> float:
	if unit_spr == null:
		return -50.0
	# v23.5: 无贴图兜底同样叠加 sprite 位移（悬空单位贴图缺失时 UI 仍随机身）
	if unit_spr.texture == null:
		return -50.0 + unit_spr.position.y
	var tex_h: float = maxf(float(unit_spr.texture.get_height()), 1.0)
	var fn := _file_name_of(unit_spr.texture)
	var foot_frac: float = get_foot_frac(fn)
	var head_frac: float = get_head_frac(fn)
	var entity_h_frac: float = maxf(1.0 - head_frac - foot_frac, 0.1)
	var disp_entity_h: float = entity_h_frac * tex_h * absf(unit_spr.scale.y)
	# v23.5: 叠加 sprite 节点位移——空中单位悬空抬升后，头顶 UI（血条/角标/等级/
	# buff 条）与枪口回退点应锚定"视觉机身"而非槽位地面。地面单位 position.y
	# 仅 ±1.2px 待机浮动噪声，可忽略。注意：悬空抬升在 apply_battle_unit_presentation
	# 里设置 position.y 后才调用各 sync_*，故 UI 首次定位即含抬升。
	return -disp_entity_h + unit_spr.position.y

# ─────────────────────────────────────────────────────────────────────────────
#  战场缩放模型（v6.14.8 内容感知重构，推翻旧手填 VISUAL_SCALE 全量表）
#  卡图换血后旧 CSV 全部失真，git 历史保留旧值。
#  几何层（card_grid_thumbnail_scale.compute_battlefield_uniform_width_scale）：
#    按 CONTENT_BBOX 的"非透明内容宽"归一到 BASE_CARD_WIDTH_PX——画布留白不再吃缩放。
#  语义层（本文件）：KIND_ERA_SCALE 兵种×时代档位给层级——现实基准（FT-17 3.6m →
#    现代 MBT 9.8m → 未来机甲外推 ~12m，相对步兵班正面 ~5m 即 0.7×→2.4×）经游戏性
#    压缩到 1.10×→1.55×（小坦克拉高保可读、大坦克封顶防离谱），总跨度 ~2.2×；
#    步兵跨时代近乎恒定（人体尺寸），未来动力甲略壮。个别卡微调进
#    VISUAL_SCALE_OVERRIDE（乘数，空 = 纯模型）。
# ─────────────────────────────────────────────────────────────────────────────
const EnemyUnitManifest = preload("res://data/enemy_unit_manifest.gd")

## 兵种×时代档位系数表（key = CombatKind → key = era 0-4）。
## 最终内容屏宽 = BASE_CARD_WIDTH_PX × 系数（× 精英/首领威压乘区，在演出层）。
## 时代语义：0 一战 / 1 二战 / 2 冷战 / 3 现代 / 4 近未来（fe_/xeno 按 4）。
const KIND_ERA_SCALE: Dictionary = {
	0: {0: 0.72, 1: 0.73, 2: 0.75, 3: 0.78, 4: 0.82},  # 轻装步兵：人体尺寸跨时代恒定，未来动力甲略大
	1: {0: 1.10, 1: 1.25, 2: 1.35, 3: 1.45, 4: 1.55},  # 装甲：FT-17 小型 → 二战中坦 → 现代 MBT → 未来悬浮/机甲
	2: {0: 0.78, 1: 0.82, 2: 0.85, 3: 0.90, 4: 0.95},  # 支援炮兵：迫击炮组 → 自行火炮/MLRS
	3: {0: 1.05, 1: 1.10, 2: 1.15, 3: 1.25, 4: 1.35},  # 空中：双翼机 → 喷气 → 重型载具/母舰（翼展现实比游戏大得多，强压缩）
	4: {0: 1.40, 1: 1.45, 2: 1.50, 3: 1.55, 4: 1.60},  # 堡垒：碉堡 → 要塞/移动基地
}

## 个别卡微调 override（id → 乘数，乘在档位系数上；查询剥 captured_/foe_ 前缀）。
## 空表 = 纯模型；实机目检后把需要偏离档位默认的卡加进来。
const VISUAL_SCALE_OVERRIDE: Dictionary = {}

const DEFAULT_VISUAL_SCALE: float = 1.0

## 内容宽占画布比例（几何层归一用；无扫描数据回退 1.0 = 旧画布口径）。
## 数组布局 [w_frac, h_frac]（generate_card_foot_anchors.py 生成）。
static func get_content_w_frac(file_name: String) -> float:
	var v: Variant = CONTENT_BBOX.get(String(file_name).strip_edges())
	if v is Array and (v as Array).size() >= 1:
		return maxf(float((v as Array)[0]), 0.0)
	return 1.0

## 从纹理路径提文件名（去目录去扩展名）。_file_name_of 公开版（几何缩放层消费）。
static func file_name_of(tex: Texture2D) -> String:
	return _file_name_of(tex)

## 卡 id 前缀 → 时代（0-4；无法判定 -1）。仅作无 era 数据时的兜底推断——
## card.era / manifest 行 era 永远优先。fe_/xeno 归近未来，guardian_ 剥壳再判。
static func _era_from_id(raw_id: String) -> int:
	var id_key := String(raw_id).strip_edges()
	for pre in ["captured_", "foe_", "guardian_"]:
		if id_key.begins_with(pre):
			id_key = id_key.substr(pre.length())
	for pair in [["ww1", 0], ["ww2", 1], ["cold", 2], ["mod", 3], ["fut", 4], ["fe_", 4], ["xeno", 4]]:
		if id_key.begins_with(String(pair[0])):
			return int(pair[1])
	return -1

## 档位查表（kind/era 越界回退中间档，不崩）。
static func _factor(kind: int, era: int) -> float:
	var row: Variant = KIND_ERA_SCALE.get(clampi(kind, 0, 4))
	if row is Dictionary:
		return float((row as Dictionary).get(clampi(era, 0, 4), DEFAULT_VISUAL_SCALE))
	return DEFAULT_VISUAL_SCALE

## 按 id 查缩放（内部剥 captured_/foe_ 前缀）：override 优先，否则经 manifest
## 兵种+时代查档位。供 enemy_archetypes.get_visual_scale_for_archetype 转发用
## （相位师产兵/敌方立绘等无 card 对象的 by-id 路径）。
static func get_visual_scale_by_id(id: String, era_hint: int = -1) -> float:
	var id_key: String = String(id).strip_edges()
	if id_key.begins_with("captured_"):
		id_key = id_key.substr(9)
	var bare := id_key.substr(4) if id_key.begins_with("foe_") else id_key
	if VISUAL_SCALE_OVERRIDE.has(id_key):
		return float(VISUAL_SCALE_OVERRIDE[id_key])
	if VISUAL_SCALE_OVERRIDE.has(bare):
		return float(VISUAL_SCALE_OVERRIDE[bare])
	var kind := EnemyUnitManifest.combat_kind_for(bare)
	if kind < 0:
		return DEFAULT_VISUAL_SCALE
	var era := era_hint if (era_hint >= 0 and era_hint <= 4) else EnemyUnitManifest.era_for(bare)
	if era < 0 or era > 4:
		era = _era_from_id(bare)
	return _factor(kind, era)

## 解析单位视觉缩放（card 对象路径）：override 优先，否则按 card 兵种×时代查档位。
## card 用弱类型避免循环依赖（CardResource 在 resources/，本数据类不应 preload 它）。
static func get_visual_scale(card) -> float:
	if card == null:
		return DEFAULT_VISUAL_SCALE
	var card_id: String = String(card.get("card_id"))
	var bare := card_id
	if bare.begins_with("captured_"):
		bare = bare.substr(9)
	if bare.begins_with("foe_"):
		bare = bare.substr(4)
	# 1) override 优先（剥前缀双查）
	if not card_id.is_empty():
		if VISUAL_SCALE_OVERRIDE.has(String(card_id).strip_edges()) or VISUAL_SCALE_OVERRIDE.has(bare):
			return get_visual_scale_by_id(card_id)
	# 2) 兵种：card 字段优先，manifest 兜底（v8 起我方 platform_type == combat_kind）
	var kind := int(card.get("combat_kind"))
	if kind < 0 or kind > 4:
		kind = int(card.get("platform_type"))
	if kind < 0 or kind > 4:
		kind = EnemyUnitManifest.combat_kind_for(bare)
	if kind < 0 or kind > 4:
		return DEFAULT_VISUAL_SCALE
	# 3) 时代：card.era 优先（synthetic 卡已回填 manifest era），前缀推断兜底
	var era := int(card.get("era"))
	if era < 0 or era > 4:
		era = EnemyUnitManifest.era_for(bare)
	if era < 0 or era > 4:
		era = _era_from_id(card_id)
	return _factor(kind, era)
