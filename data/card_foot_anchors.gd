const DEFAULT_VISUAL_SCALE: float = 1.0

## 按 id 查缩放（内部剥 captured_ 前缀）。供 enemy_archetypes.get_visual_scale_for_archetype 转发用。
static func get_visual_scale_by_id(id: String) -> float:
	var id_key: String = id
	# 剥离 captured_ 前缀（缴获卡 card_id 形如 captured_cold_arm_t72_e）
	if id_key.begins_with("captured_"):
		id_key = id_key.substr(9)
	if not id_key.is_empty() and VISUAL_SCALE.has(id_key):
		return float(VISUAL_SCALE[id_key])
	return DEFAULT_VISUAL_SCALE

## 解析单位视觉缩放（接收 card 对象，card_id 直接查表 + platform_type 兜底）。
## card 用弱类型避免循环依赖（CardResource 在 resources/，本数据类不应 preload 它）。
static func get_visual_scale(card) -> float:
	if card == null:
		return 1.0
	# 1) card_id 直接查表（敌方 archetype_id / 缴获卡 captured_xxx 均命中，内部剥前缀）
	var card_id: String = String(card.get("card_id"))
	if not card_id.is_empty():
		var v1: float = get_visual_scale_by_id(card_id)
		if v1 > 0.0 and v1 != 1.0:
			return v1
	# 2) platform_type → archetype 兜底（我方卡走这条）
	var pt: int = int(card.get("platform_type"))
	if PLAYER_PLATFORM_TO_SCALE_ARCHETYPE.has(pt):
		var arch: String = String(PLAYER_PLATFORM_TO_SCALE_ARCHETYPE[pt])
		var v2: float = get_visual_scale_by_id(arch)
		if v2 > 0.0 and v2 != 1.0:
			return v2
	return 1.0
